<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aimfgdigest.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/run_weekly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- Tuesdays at 10:00. Weekday 2 = Tuesday (0 and 7 both mean Sunday). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>2</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- If the Mac was asleep at 10:00, run as soon as it wakes.
         This is the main reason to use launchd over cron: cron simply skips
         a job whose time passed while the machine was off. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/schedule.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/schedule.log</string>
</dict>
</plist>
