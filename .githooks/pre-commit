#!/bin/bash
# Blocks a commit that contains credentials.
#
# This exists because a real API key and Gmail app password once ended up in
# .env.example, which is a tracked file. .gitignore does not help there -- the
# file is supposed to be committed, just not with values in it.

FAIL=0
PATTERNS='sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20}|xoxb-[0-9]{10}|AKIA[0-9A-Z]{16}'

for f in $(git diff --cached --name-only --diff-filter=ACM); do
  [ -f "$f" ] || continue

  if grep -qE "$PATTERNS" "$f"; then
    echo "BLOCKED: $f contains something shaped like an API key."
    FAIL=1
  fi

  # Any .env-style file that is tracked must have empty values.
  case "$f" in
    *.env|.env.*|*.env.example)
      if grep -qE '^(SMTP_PASSWORD|ANTHROPIC_API_KEY|SMTP_USER|EMAIL_RECIPIENTS)=.+' "$f"; then
        echo "BLOCKED: $f has a filled-in credential or recipient field."
        echo "         Template files must ship with empty values."
        FAIL=1
      fi
      ;;
  esac
done

if [ $FAIL -ne 0 ]; then
  echo ""
  echo "Commit stopped. Clear the values, then commit again."
  echo "To override in an emergency: git commit --no-verify"
  exit 1
fi
