# ============================================================================
# AI -> Manufacturing Weekly Digest  --  configuration
# ============================================================================
# Copy this file to `.env` and fill in the blanks:
#
#     cp .env.example .env
#
# Then verify it before trusting the cron job:
#
#     python digest_agent.py --check-smtp              # tests login only
#     python digest_agent.py --test-email you@you.com --send
#
# NOTHING IS EMAILED unless you pass --send. The default is a preview.
# Never commit .env -- it holds your API key and mail password.
# ============================================================================


# ---------------------------------------------------------------------------
# 1. ANTHROPIC API  (required)
# ---------------------------------------------------------------------------
# From console.anthropic.com -> API keys. Starts with "sk-ant-".
ANTHROPIC_API_KEY=

# Optional: override the models. Defaults are Opus 5.5 to write, Haiku 4.5 to
# screen. Set the writer to claude-sonnet-5-5 to roughly halve the cost per run.
# WRITER_MODEL=claude-opus-5-5
# SCREEN_MODEL=claude-haiku-4-5

# Hard spend cap in USD per run. The script aborts before exceeding it.
DIGEST_BUDGET_USD=2.00


# ---------------------------------------------------------------------------
# 2. MAIL SERVER  (required to send)
# ---------------------------------------------------------------------------
# Common settings -- use whichever matches your provider:
#
#   WORKS TODAY
#   Gmail / Google Workspace   smtp.gmail.com         587   starttls
#   iCloud Mail                smtp.mail.me.com       587   starttls
#   Fastmail                   smtp.fastmail.com      465   ssl
#   Resend                     smtp.resend.com        587   starttls
#   SendGrid                   smtp.sendgrid.net      587   starttls
#   Mailgun                    smtp.mailgun.org       587   starttls
#   Amazon SES (us-east-1)     email-smtp.us-east-1.amazonaws.com  587  starttls
#
#   DOES NOT WORK ANY MORE
#   Outlook.com / Hotmail      smtp-mail.outlook.com
#   Microsoft 365 business     smtp.office365.com
#
# !! MICROSOFT NO LONGER ACCEPTS PASSWORDS OVER SMTP !!
# Basic authentication for SMTP was permanently retired, reaching 100% rejection
# on 30 April 2026. App passwords ARE basic auth, so they are rejected too. A
# correct Outlook address with a correct app password still fails with
# "535 5.7.3 Authentication unsuccessful" -- no password works here any more.
# Sending from a Microsoft address now requires OAuth2, which this script does
# not implement. Use one of the providers under WORKS TODAY instead.
#
SMTP_HOST=
SMTP_PORT=587

# starttls (port 587, most common) | ssl (port 465) | none (don't)
SMTP_SECURITY=starttls

# Your full email address, usually.
SMTP_USER=

# !! IMPORTANT !!
# Gmail, Outlook and iCloud all REJECT your normal account password here.
# You must generate an app-specific password:
#   Gmail:   myaccount.google.com -> Security -> 2-Step Verification -> App passwords
#   iCloud:  appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
#   Outlook: account.microsoft.com/security -> App passwords
# For SendGrid/Mailgun/SES, use the API key or SMTP credential they issue.
SMTP_PASSWORD=


# ---------------------------------------------------------------------------
# 3. HOW THE EMAIL LOOKS
# ---------------------------------------------------------------------------
# The name recipients see in their inbox.
EMAIL_FROM_NAME=AI x Manufacturing Digest

# The From: address. Leave blank to reuse SMTP_USER.
# With SendGrid/Mailgun/SES this must be a domain you have verified.
EMAIL_FROM=

# Where replies go. Blank = replies go to EMAIL_FROM.
EMAIL_REPLY_TO=

# Prepended to every subject line. Blank for none.
# The model writes a real subject each week, so a short tag works best here.
EMAIL_SUBJECT_PREFIX=[AI x Mfg]

# Appears in small text at the bottom of every issue.
EMAIL_FOOTER=You're getting this because you asked for a weekly roundup of AI research that touches manufacturing. Written by an automated scout, reviewed before sending.

# How people get off the list. A URL or an email address.
# This also turns on the native "Unsubscribe" button in Gmail and Apple Mail.
# Strongly recommended: sending bulk email without an opt-out is bad practice
# and, in the US, CAN-SPAM requires a working opt-out mechanism.
EMAIL_UNSUBSCRIBE=


# ---------------------------------------------------------------------------
# 4. THE MAILING LIST
# ---------------------------------------------------------------------------
# Two ways to set recipients. You can use either or both.
#
# (a) Inline, comma-separated -- fine for a handful of people:
EMAIL_RECIPIENTS=

# (b) A file, one address per line -- better once the list grows.
#     Lines starting with # are ignored. See recipients.example.txt.
EMAIL_RECIPIENTS_FILE=recipients.txt

# Everyone is placed in Bcc, so no recipient ever sees another's address.
# Addresses are sent in batches to stay under provider limits.
#   Gmail free: ~500/day. Workspace: ~2,000/day. SendGrid etc: much higher.
EMAIL_BATCH_SIZE=40
EMAIL_BATCH_PAUSE_SECONDS=5
